{
  "name": "diremor-sac-api",
  "version": "1.0.0",
  "description": "Backend API para el Sistema en Línea de Gestión Administrativo Comercial integrado a Contabilidad (SAC) - DIREMOR S.R.L.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
