# =====================================================================
# DIREMOR SAC - Variables de Entorno (Coolify / Entorno de Producción)
# =====================================================================
#
# INSTRUCCIONES DE CONFIGURACIÓN:
# 1. En Coolify: Añade estas variables en la sección "Environment Variables" de la aplicación.
# 2. En Local: Copia este archivo a `.env` (`cp .env.example .env`) y personaliza los secretos.
# 3. NUNCA subas a Git un archivo `.env` con contraseñas o secretos de producción.

# --- Configuración del Servicio y Entorno ---
NODE_ENV=production
PORT=3000
APP_DOMAIN=sac.diremor.com

# --- Persistencia: PostgreSQL 16+ en Red Privada Docker ---
POSTGRES_DB=sac_diremor
POSTGRES_USER=sac_admin
# REEMPLAZA: Genera una contraseña segura para la base de datos (mínimo 24 caracteres)
POSTGRES_PASSWORD=REEMPLAZA_PASSWORD_SEGURO_POSTGRES_2026

# Cadena de conexión interna entre contenedores dentro de coolify-network:
DATABASE_URL=postgresql://sac_admin:REEMPLAZA_PASSWORD_SEGURO_POSTGRES_2026@sac-postgres:5432/sac_diremor

# --- Seguridad y Tokens JWT ---
# REEMPLAZA: Genera una clave aleatoria de 64 bytes (ej. `openssl rand -hex 32`)
JWT_SECRET=REEMPLAZA_CON_CLAVE_CRIPTOGRAFICA_JWT_64_BYTES
JWT_EXPIRES_IN=8h

# --- Parámetros Fiscales SIN (Servicio de Impuestos Nacionales de Bolivia) ---
# Modalidades soportadas: ELECTRONICA_EN_LINEA | COMPUTARIZADA_EN_LINEA
SIN_MODALIDAD=ELECTRONICA_EN_LINEA
SIN_NIT_EMISOR=1028374029
SIN_CODIGO_SISTEMA=DIREMOR_SAC_V2
SIN_API_ENDPOINT=https://pilotosiatservicios.impuestos.gob.bo
